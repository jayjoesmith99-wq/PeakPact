{
  "name": "peakpact",
  "version": "1.0.0",
  "main": "index.tsx",
  "expo": {
    "web": {
      "bundler": "metro"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test tests/*.test.ts",
    "export:web": "expo export -p web",
    "release:check": "npm run typecheck && npm run test && npm run export:web",
    "build:android": "npx eas-cli build --platform android --profile production",
    "build:android:aab": "npx eas-cli build --platform android --profile production-aab",
    "build:android:apk": "npx eas-cli build --platform android --profile preview-apk",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "submit:android": "npx eas-cli submit --platform android --profile production",
    "release:android-web": "npm run release:check && npm run build:android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^26.2.0",
    "@react-native-firebase/app": "^26.2.0",
    "@react-native-firebase/crashlytics": "^26.2.0",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~54.0.35",
    "expo-av": "~16.0.8",
    "expo-haptics": "~15.0.8",
    "expo-localization": "~17.0.9",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "firebase": "^12.17.1",
    "i18next": "^26.3.6",
    "lucide-react-native": "^1.24.0",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^10.6.0",
    "react-native-purchases-ui": "^10.6.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  },
  "private": true
}
