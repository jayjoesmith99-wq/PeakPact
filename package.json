{
  "name": "peakpact",
  "version": "1.0.0",
  "main": "index.ts",
  "expo": {
    "web": {
      "bundler": "metro"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test tests/*.test.ts",
    "export:web": "expo export -p web",
    "release:check": "npm run typecheck && npm run test && npm run export:web",
    "build:android": "npx eas-cli build --platform android --profile production",
    "build:android:aab": "npx eas-cli build --platform android --profile production-aab",
    "build:android:apk": "npx eas-cli build --platform android --profile preview-apk",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "submit:android": "npx eas-cli submit --platform android --profile production",
    "release:android-web": "npm run release:check && npm run build:android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~54.0.35",
    "expo-av": "~16.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "lucide-react-native": "^1.24.0",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  },
  "private": true
}
