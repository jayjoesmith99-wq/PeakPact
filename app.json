{
  "expo": {
    "name": "PeakPact",
    "slug": "PeakPact",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.peakpact.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/elite-splash.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.PeakPact",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow PeakPact to access your microphone to record completion reports."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "83a77677-1639-418e-aeca-ec783dcf075e"
      }
    }
  }
}
