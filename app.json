{
  "expo": {
    "name": "PeakPact",
    "slug": "peakpact-app",
    "version": "1.0.2",
    "scheme": "peakpact",
    "orientation": "portrait",
    "icon": "./assets/icon-flat-1024.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/elite-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alparbodi.peakpact",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.alparbodi.peakpact",
      "googleServicesFile": "./google-services.json",
      "versionCode": 6,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "expo-notifications",
      [
        "expo-av",
        {
          "microphonePermission": "Allow PeakPact to access your microphone to record completion reports."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PeakPact to access your photos for mission proof.",
          "cameraPermission": "Allow PeakPact to take photos for mission proof."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow PeakPact to verify your execution location."
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "9e1ba50d-a318-4a6c-9092-634a93449605"
      }
    },
    "owner": "nobodyknowswhy",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9e1ba50d-a318-4a6c-9092-634a93449605"
    }
  }
}
